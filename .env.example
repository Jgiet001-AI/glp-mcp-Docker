# GreenLake MCP Server Configuration
# ===================================
# Copy this file to .env and fill in your credentials
# DO NOT commit the .env file to version control!

# GreenLake API Base URL (default: https://global.api.greenlake.hpe.com)
GREENLAKE_API_BASE_URL=https://global.api.greenlake.hpe.com

# Your GreenLake OAuth2 Client ID
GREENLAKE_CLIENT_ID=your_client_id_here

# Your GreenLake OAuth2 Client Secret
GREENLAKE_CLIENT_SECRET=your_client_secret_here

# Your GreenLake Workspace ID
GREENLAKE_WORKSPACE_ID=your_workspace_id_here

# MCP Tool Mode: "dynamic" (default) or "static"
MCP_TOOL_MODE=dynamic

# Logging level: DEBUG, INFO, WARNING, ERROR
GREENLAKE_LOG_LEVEL=INFO

# Enable file logging: true or false
GREENLAKE_FILE_LOGGING=false
